{
  "name": "xiaomi-powerbank-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Vue 3 WebHID console for Xiaomi power banks, deployable on Cloudflare Pages.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "deploy": "npm run build && wrangler pages deploy dist --project-name xiaomi-powerbank-console"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.151.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
